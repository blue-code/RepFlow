default_platform(:ios)

API_KEY_ID    = "33P5W93GJQ"
API_ISSUER_ID = "ed28e2d3-ce1d-4d24-8e58-373132e4b554"
API_KEY_PATH  = "/Volumes/SSD/DEV_SSD/MY/BurnCoach/fastlane/AuthKey_33P5W93GJQ.p8"
TEAM_ID       = "KUDC7C6Z9H"

platform :ios do

  desc "TestFlight에 새 빌드 업로드"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    build_num = latest_testflight_build_number(
      app_identifier: "com.digimaru.repflow",
      api_key: api_key
    ) + 1

    increment_build_number(
      build_number: build_num,
      xcodeproj: "RepFlow.xcodeproj"
    )

    # Let xcodebuild handle everything — automatic signing + provisioning
    # Xcode 26 auto-provisions HealthKit-capable profiles via API key
    auth = "-allowProvisioningUpdates" \
      " -authenticationKeyID #{API_KEY_ID}" \
      " -authenticationKeyIssuerID #{API_ISSUER_ID}" \
      " -authenticationKeyPath #{API_KEY_PATH}"

    sh("cd .. && xcodebuild -project RepFlow.xcodeproj -scheme RepFlow" \
      " -configuration Release -destination 'generic/platform=iOS'" \
      " clean archive -archivePath ./build/RepFlow.xcarchive" \
      " #{auth}")

    sh("cd .. && xcodebuild -exportArchive" \
      " -archivePath ./build/RepFlow.xcarchive" \
      " -exportPath ./build" \
      " -exportOptionsPlist fastlane/ios_export.plist" \
      " #{auth}")

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/RepFlow.ipa",
      skip_waiting_for_build_processing: true,
      changelog: changelog_from_git_commits(
        commits_count: 10,
        pretty: "- %s",
        merge_commit_filtering: "exclude_merges"
      )
    )

    clean_build_artifacts
  end

  desc "유닛 테스트"
  lane :test do
    run_tests(
      project: "RepFlow.xcodeproj",
      scheme: "RepFlow",
      devices: ["iPhone 17"],
      clean: true
    )
  end

  desc "스크린샷 + 메타데이터 ASC 업로드"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end